# ============================================================
#  AVIATOR BACKEND — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit your actual .env to GitHub!
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- JWT Secret (generate a long random string — never share) ---
JWT_SECRET=replace_with_a_very_long_random_secret_string_here
JWT_EXPIRES_IN=7d

# --- Supabase (PostgreSQL) ---
# Get these from your Supabase project → Settings → Database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- Africa's Talking (Free OTP SMS) ---
# Sign up at https://africastalking.com → create app → get API key
AT_USERNAME=sandbox          # use "sandbox" for testing, your real username for live
AT_API_KEY=your_at_api_key_here

# --- Instasend (M-Pesa Payments) ---
# Get from your Instasend merchant dashboard → API Keys
INSTASEND_API_KEY=your_instasend_api_key_here
INSTASEND_API_SECRET=your_instasend_secret_here
INSTASEND_BASE_URL=https://sandbox.instasend.io  # change to https://api.instasend.io for live

# --- App URL (your Railway/Render deployed URL for callbacks) ---
APP_URL=https://your-app-name.railway.app

# --- Game Settings ---
HOUSE_EDGE=0.05              # 5% house edge on crash multiplier
MIN_BET=10                   # Minimum bet in KES
MAX_BET=50000                # Maximum bet in KES
MIN_CASHOUT=1.01             # Minimum cashout multiplier

# --- Admin ---
ADMIN_SECRET=replace_with_strong_admin_password
